<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="850"
             x:Class="DeadModer.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <!-- ЗАГОЛОВОК -->
            <Border Background="#75111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="10" Padding="24,18">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding Loc[Settings_Title]}" FontSize="22" FontWeight="Black" Foreground="#FFFFFF" />
                        </StackPanel>
                        <TextBlock Text="{Binding Loc[Settings_Subtitle]}" FontSize="12" Foreground="#858EA0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#161C2C" BorderBrush="#25324A" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                        <TextBlock Text="CONFIG" FontWeight="Bold" FontSize="11" Foreground="#CBD5E1" LetterSpacing="1.5" />
                    </Border>
                </Grid>
            </Border>

            <!-- БАННЕР СТАТУСА ОБНАРУЖЕНИЯ -->
            <Border Background="#121824" BorderBrush="#1E2A3E" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="{Binding DetectionStatus}" FontSize="12" Foreground="#BAE6FD" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding AutoDetectSteamPathCommand}"
                            Height="30" Padding="14,0" CornerRadius="6"
                            BorderThickness="0"
                            Background="#0284C7" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding Loc[Settings_AutoDetect]}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- СЕКЦИЯ 1: ЯЗЫК И ФОНОВОЕ ИЗОБРАЖЕНИЕ -->
            <Border Background="#75111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Loc[Settings_AppearanceSection]}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />

                    <!-- Выбор языка -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings_Language]}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Русский / English" FontSize="11" Foreground="#6C7588" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="RU" 
                                    Command="{Binding SelectLanguageCommand}" CommandParameter="ru"
                                    Height="30" Padding="14,0" CornerRadius="6"
                                    BorderBrush="#253046" BorderThickness="1"
                                    Classes.active="{Binding IsRussianSelected}"
                                    Classes.inactive="{Binding !IsRussianSelected}">
                                <Button.Styles>
                                    <Style Selector="Button.active">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                    <Style Selector="Button.inactive">
                                        <Setter Property="Background" Value="#141926" />
                                        <Setter Property="Foreground" Value="#858EA0" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                            <Button Content="EN" 
                                    Command="{Binding SelectLanguageCommand}" CommandParameter="en"
                                    Height="30" Padding="14,0" CornerRadius="6"
                                    BorderBrush="#253046" BorderThickness="1"
                                    Classes.active="{Binding IsEnglishSelected}"
                                    Classes.inactive="{Binding !IsEnglishSelected}">
                                <Button.Styles>
                                    <Style Selector="Button.active">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                    <Style Selector="Button.inactive">
                                        <Setter Property="Background" Value="#141926" />
                                        <Setter Property="Foreground" Value="#858EA0" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- СЕКЦИЯ 2: ПУТИ К ИГРЕ И ФАЙЛАМ -->
            <Border Background="#75111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Loc[Settings_PathsSection]}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />

                    <!-- Путь к Deadlock -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Loc[Settings_GamePath]}" FontSize="12" Foreground="#858EA0" />
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding GamePath}" 
                                     Background="#121624" Foreground="#FFFFFF" BorderBrush="#1F283C" BorderThickness="1" 
                                     CornerRadius="6" Height="38" VerticalContentAlignment="Center" Padding="12,0" />
                            <Button Grid.Column="1" Content="{Binding Loc[Settings_Autosearch]}" Margin="8,0,0,0"
                                    Command="{Binding AutoDetectSteamPathCommand}"
                                    Background="#141926" BorderBrush="#25324A" BorderThickness="1"
                                    Foreground="#CBD4E1" Height="38" Padding="14,0" CornerRadius="6" FontSize="12" />
                        </Grid>
                        <TextBlock Text="{Binding Loc[Settings_GamePathHint]}" FontSize="11" Foreground="#555E70" />
                    </StackPanel>

                    <!-- Папка модов addons -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Loc[Settings_AddonsPath]}" FontSize="12" Foreground="#858EA0" />
                        <TextBox Text="{Binding ModsStoragePath}" 
                                 Background="#121624" Foreground="#FFFFFF" BorderBrush="#1F283C" BorderThickness="1" 
                                 CornerRadius="6" Height="38" VerticalContentAlignment="Center" Padding="12,0" />
                        <TextBlock Text="{Binding Loc[Settings_AddonsPathHint]}" FontSize="11" Foreground="#555E70" />
                    </StackPanel>

                    <!-- Папка бэкапов -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Loc[Settings_BackupsPath]}" FontSize="12" Foreground="#858EA0" />
                        <TextBox Text="{Binding BackupsPath}" 
                                 Background="#121624" Foreground="#FFFFFF" BorderBrush="#1F283C" BorderThickness="1" 
                                 CornerRadius="6" Height="38" VerticalContentAlignment="Center" Padding="12,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- СЕКЦИЯ 3: ПАРАМЕТРЫ ПОВЕДЕНИЯ -->
            <Border Background="#75111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Loc[Settings_BehaviorSection]}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />

                    <!-- Проверка обновлений -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings_AutoCheckUpdates]}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding Loc[Settings_AutoCheckUpdatesHint]}" FontSize="11" Foreground="#6C7588" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}" OnContent="" OffContent="" />
                    </Grid>

                    <Separator Background="#191D2A" Height="1" />

                    <!-- Запуск игры с модами -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings_LaunchWithMods]}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding Loc[Settings_LaunchWithModsHint]}" FontSize="11" Foreground="#6C7588" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchGameWithMods}" OnContent="" OffContent="" />
                    </Grid>

                    <Separator Background="#191D2A" Height="1" />

                    <!-- Сворачивание в трей -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Loc[Settings_CloseToTray]}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding Loc[Settings_CloseToTrayHint]}" FontSize="11" Foreground="#6C7588" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" OnContent="" OffContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- СЕКЦИЯ 4: СОХРАНЕНИЕ -->
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Content="{Binding Loc[Btn_SaveSettings]}" 
                        Command="{Binding SaveSettingsCommand}"
                        Height="38" Padding="22,0" CornerRadius="6"
                        BorderThickness="0"
                        Background="#2563EB" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" />
                
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="13" Foreground="#4ADE80" 
                           VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
