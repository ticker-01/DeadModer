<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:ctrl="using:DeadModer.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="DeadModer.UI.Views.HeroesView"
             x:DataType="vm:HeroesViewModel"
             Background="Transparent">

    <Design.DataContext>
        <vm:HeroesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" Margin="32,20,32,24">
        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ: ПОИСК ГЕРОЯ И ФИЛЬТРЫ ПО РОЛЯМ В СТИЛЕ GILDED NOIR -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,22">
            <!-- Поле поиска: [ 🔍 Поиск героя... ] -->
            <Border Grid.Column="0" Background="#08090C" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                    CornerRadius="14" Height="48" Width="340" VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto, *">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}" Width="16" Height="16"
                              Foreground="{StaticResource BrushDimText}" Margin="16,0,10,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchQuery}"
                             PlaceholderText="Поиск героя по имени или роли..."
                             Background="Transparent"
                             Foreground="{StaticResource BrushBoneText}"
                             BorderThickness="0"
                             Padding="2,0,12,0"
                             VerticalContentAlignment="Center"
                             FontSize="13" />
                </Grid>
            </Border>

            <!-- Фильтр-пилюли: [Все герои] [Атакующие] [Защита] [Поддержка] [Контроль] с акцентными ромбиками ролей -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="pillFilter"
                        Classes.active="{Binding SelectedRoleFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='All'}"
                        Command="{Binding FilterRoleCommand}" CommandParameter="All">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconCategory}" Width="12" Height="12" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[Heroes_RoleAll]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="pillFilter"
                        Classes.active="{Binding SelectedRoleFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Assault'}"
                        Command="{Binding FilterRoleCommand}" CommandParameter="Assault">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Fill="{StaticResource BrushEmberRed}" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="{Binding Loc[Heroes_RoleAssault]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="pillFilter"
                        Classes.active="{Binding SelectedRoleFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Defense'}"
                        Command="{Binding FilterRoleCommand}" CommandParameter="Defense">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Fill="{StaticResource BrushSapphireBlue}" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="{Binding Loc[Heroes_RoleDefense]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="pillFilter"
                        Classes.active="{Binding SelectedRoleFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Support'}"
                        Command="{Binding FilterRoleCommand}" CommandParameter="Support">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Fill="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="{Binding Loc[Heroes_RoleSupport]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="pillFilter"
                        Classes.active="{Binding SelectedRoleFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Control'}"
                        Command="{Binding FilterRoleCommand}" CommandParameter="Control">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Fill="{StaticResource BrushViolet}" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="{Binding Loc[Heroes_RoleControl]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. ОСНОВНОЙ КОНТЕНТ: СЕТКА 4х4 СЛЕВА + ИНСПЕКТОР ГЕРОЯ СПРАВА -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 400">
            <!-- 2.1 СЕТКА КАРТОЧЕК ПЕРСОНАЖЕЙ (4 КОЛОНКИ х 4 СТРОКИ) -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,24,0">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayedHeroes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}"
                                        Padding="0" Margin="0,0,16,16"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Button.Styles>

                                    <!-- КАРТОЧКА ГЕРОЯ В СТИЛЕ GILDED NOIR -->
                                    <Border Width="184" Height="236" CornerRadius="16" ClipToBounds="True"
                                            Background="{StaticResource BrushCardGradient}"
                                            Classes.selectedCard="{Binding IsSelected}"
                                            BorderBrush="{StaticResource BrushBorderLine}"
                                            BorderThickness="1">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLineGold}" />
                                                <Setter Property="Background" Value="#181D2A" />
                                            </Style>
                                            <Style Selector="Border.selectedCard">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </Style>
                                        </Border.Styles>

                                        <Grid RowDefinitions="*, Auto">
                                            <!-- ОБЛАСТЬ ПОРТРЕТА ГЕРОЯ -->
                                            <Grid Grid.Row="0">
                                                <!-- Высококачественный портрет персонажа -->
                                                <Image Source="{Binding CardBitmap}" Stretch="UniformToFill"
                                                       IsVisible="{Binding CardBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                <!-- Запасной фон, если картинка еще грузится или это секретная лавка -->
                                                <Grid Background="#0E1117" IsVisible="{Binding CardBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                                    <!-- Значок для Curiosity Shop -->
                                                    <PathIcon Data="{StaticResource IconCrosshair}" Width="48" Height="48"
                                                              Foreground="{StaticResource BrushBorderLineGold}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding IsLocked}" />
                                                </Grid>

                                                <!-- Мягкий градиент затемнения к нижней части карточки -->
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,40%" EndPoint="0%,100%">
                                                            <GradientStop Offset="0.0" Color="#00000000" />
                                                            <GradientStop Offset="1.0" Color="#F208090C" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- ИНДИКАТОР ВЫБОРА: ЗОЛОТОЙ ЧЕКМАРК В ПРАВОМ ВЕРХНЕМ УГЛУ -->
                                                <Border Width="24" Height="24" CornerRadius="12"
                                                        Background="{StaticResource BrushGoldGradient}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="10" IsVisible="{Binding IsSelected}">
                                                    <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                                                              Foreground="#1A1204" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- НИЗ КАРТОЧКИ: ИМЯ ГЕРОЯ И РОЛЕВОЙ БЕЙДЖ -->
                                            <StackPanel Grid.Row="1" Margin="12,0,12,12" Spacing="6" VerticalAlignment="Center">
                                                <!-- Имя героя (Oswald) -->
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource FontOswald}"
                                                           FontWeight="Bold" FontSize="14" LetterSpacing="0.04"
                                                           Foreground="{StaticResource BrushBoneText}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Ролевой бейдж (Векторная иконка + текст роли) -->
                                                <Border Background="#121620" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                        CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <PathIcon Data="{Binding RoleIconPathData}" Width="11" Height="11"
                                                                  Foreground="{Binding BadgeColor}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Role}"
                                                                   FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding BadgeColor}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ПАГИНАЦИЯ: < 1 2 3 4 > (GILDED NOIR) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,0" VerticalAlignment="Center">
                    <Button Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrevPage}" Classes="pillPagination" VerticalAlignment="Center">
                        <TextBlock Text="‹" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding GoToPageCommand}" CommandParameter="1"
                            Classes="pillPagination" Classes.active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}"
                            VerticalAlignment="Center">
                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding GoToPageCommand}" CommandParameter="2"
                            Classes="pillPagination" Classes.active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}"
                            VerticalAlignment="Center">
                        <TextBlock Text="2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding GoToPageCommand}" CommandParameter="3"
                            Classes="pillPagination" Classes.active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}"
                            VerticalAlignment="Center">
                        <TextBlock Text="3" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding GoToPageCommand}" CommandParameter="4"
                            Classes="pillPagination" Classes.active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}"
                            VerticalAlignment="Center">
                        <TextBlock Text="4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" Classes="pillPagination" VerticalAlignment="Center">
                        <TextBlock Text="›" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2.2 ПРАВАЯ ПАНЕЛЬ: ПОДРОБНЫЙ ИНСПЕКТОР ВЫБРАННОГО ГЕРОЯ (STICKY GILDED NOIR) -->
            <Border Grid.Column="1" Background="{StaticResource BrushCardBannerGradient}" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1"
                    CornerRadius="18" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0" IsVisible="{Binding SelectedHero, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- АРТ / ВЕРХНИЙ БАННЕР ГЕРОЯ (ТОЧНО ПО СТИЛЮ DEADLOCK) -->
                        <Border Height="270" Background="#08090C" ClipToBounds="True">
                            <Grid>
                                <!-- Высококачественный вертикальный арт героя -->
                                <Image Source="{Binding SelectedHero.FullBitmap}" Stretch="UniformToFill" />

                                <!-- Градиентное затемнение внизу арта -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="0%,100%">
                                            <GradientStop Offset="0.0" Color="#00000000" />
                                            <GradientStop Offset="1.0" Color="#F208090C" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Ролевой бейдж в правом верхнем углу -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                                        Background="#DD0E1117" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{Binding SelectedHero.RoleIconPathData}" Width="12" Height="12"
                                                  Foreground="{Binding SelectedHero.BadgeColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedHero.RoleBadgeText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding SelectedHero.BadgeColor}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ИНФО-БЛОК ПОД АРТОМ ГЕРОЯ -->
                        <StackPanel Margin="22,14,22,20" Spacing="14">
                            <!-- Имя и титул героя -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedHero.Title}"
                                           FontFamily="{StaticResource FontOswald}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldLight}" LetterSpacing="0.04" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedHero.Epithet}"
                                           FontFamily="{StaticResource FontPlayfair}"
                                           FontSize="13" FontStyle="Italic"
                                           Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Описание героя (Лор) -->
                            <TextBlock Text="{Binding SelectedHero.LoreSummary}" FontSize="12" Foreground="{StaticResource BrushBoneText}"
                                       LineHeight="19" TextWrapping="Wrap" VerticalAlignment="Center" />

                            <!-- 5 ИКОНОК СПОСОБНОСТЕЙ В КРУЖОЧКАХ С ПОДПИСЯМИ -->
                            <ItemsControl ItemsSource="{Binding SelectedHero.Abilities}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="5" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <!-- Круглый слот способности с золотой окантовкой -->
                                            <Border Width="46" Height="46" CornerRadius="23"
                                                    Background="#141824" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1.2">
                                                <PathIcon Data="{Binding IconPathData}" Width="18" Height="18"
                                                          Foreground="{StaticResource BrushGoldLight}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Подпись (Пассивная, 1, 2, 3, Ульта) -->
                                            <TextBlock Text="{Binding Slot}" FontSize="10.5" Foreground="{StaticResource BrushDimText}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- БЛОК СТАТИСТИКИ (ЗДОРОВЬЕ, ВЫНОСЛИВОСТЬ, СКОРОСТЬ) -->
                            <StackPanel Spacing="10">
                                <!-- Здоровье -->
                                <Grid ColumnDefinitions="20, 100, 45, *" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconHeart}" Width="13" Height="13"
                                              Foreground="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[Heroes_StatHp]}" FontSize="12"
                                               Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedHero.Hp}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                    <!-- Прогресс-бар здоровья -->
                                    <Border Grid.Column="3" Height="6" CornerRadius="3" Background="#141822" ClipToBounds="True" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding SelectedHero.HpPercent}" Minimum="0" Maximum="100"
                                                      Foreground="{StaticResource BrushSpectralGreen}" Background="Transparent" BorderThickness="0" Height="6" />
                                    </Border>
                                </Grid>

                                <!-- Выносливость -->
                                <Grid ColumnDefinitions="20, 100, 45, *" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconBolt}" Width="13" Height="13"
                                              Foreground="{StaticResource BrushSapphireBlue}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[Heroes_StatStamina]}" FontSize="12"
                                               Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedHero.Stamina, StringFormat='{}{0:F1}'}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                    <!-- Прогресс-бар выносливости -->
                                    <Border Grid.Column="3" Height="6" CornerRadius="3" Background="#141822" ClipToBounds="True" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding SelectedHero.StaminaPercent}" Minimum="0" Maximum="100"
                                                      Foreground="{StaticResource BrushSapphireBlue}" Background="Transparent" BorderThickness="0" Height="6" />
                                    </Border>
                                </Grid>

                                <!-- Скорость -->
                                <Grid ColumnDefinitions="20, 100, 45, *" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconSpeed}" Width="13" Height="13"
                                              Foreground="{StaticResource BrushGold}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[Heroes_StatSpeed]}" FontSize="12"
                                               Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedHero.Speed}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                    <!-- Прогресс-бар скорости -->
                                    <Border Grid.Column="3" Height="6" CornerRadius="3" Background="#141822" ClipToBounds="True" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding SelectedHero.SpeedPercent}" Minimum="0" Maximum="100"
                                                      Foreground="{StaticResource BrushGold}" Background="Transparent" BorderThickness="0" Height="6" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- БЛОК ОСОБЕННОСТЕЙ (ПУНКТЫ МАРКЕРОВ) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Loc[Heroes_Features]}"
                                           FontFamily="{StaticResource FontOswald}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding SelectedHero.Features}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2" VerticalAlignment="Center">
                                                <Rectangle Width="5" Height="5" Fill="{StaticResource BrushGold}" VerticalAlignment="Center">
                                                    <Rectangle.RenderTransform>
                                                        <RotateTransform Angle="45" />
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource BrushBoneText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- КНОПКА ДЕЙСТВИЯ: [ПОСМОТРЕТЬ МОДЫ ГЕРОЯ В КАТАЛОГЕ] -->
                            <Button Command="{Binding ViewHeroModsCommand}"
                                    Classes="btnGold"
                                    Height="44" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconMods}" Width="15" Height="15" Foreground="#1A1204" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc[Heroes_ActionDetails]}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
