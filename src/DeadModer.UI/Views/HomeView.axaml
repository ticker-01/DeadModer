<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:views="using:DeadModer.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="DeadModer.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="Transparent">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" Spacing="24">

            <!-- 1. ГЛАВНЫЙ БАННЕР ПРИВЕТСТВИЯ DEADLOCK -->
            <Border Background="#80111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="12" Padding="32,26" ClipToBounds="True">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#161B28" BorderBrush="#25324A" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="SOURCE 2 ENGINE" FontSize="10" FontWeight="Bold" Foreground="#CBD5E1" LetterSpacing="1" />
                            </Border>
                            <Border Background="#10251B" BorderBrush="#1E442F" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="STATUS: ADDONS READY" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" LetterSpacing="1" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="DEADLOCK MOD MANAGER"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#FFFFFF"
                                   LineHeight="34" />

                        <TextBlock Text="Автоматическая установка модов, скинов героев и кастомных звуков в game/citadel/addons с поддержкой pakXX_dir.vpk."
                                   FontSize="13"
                                   Foreground="#858EA0"
                                   MaxWidth="580"
                                   LineHeight="20" />

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                            <!-- Запуск игры -->
                            <Button Command="{Binding LaunchGameCommand}"
                                    Height="40" Padding="20,0" CornerRadius="8"
                                    Background="#15803D" BorderBrush="#22C55E" BorderThickness="1"
                                    Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlay}" Width="13" Height="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Запустить Deadlock" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- В каталог модов -->
                            <Button Command="{Binding GoToCatalogCommand}"
                                    Height="40" Padding="18,0" CornerRadius="8"
                                    Background="#141926" BorderBrush="#25324A" BorderThickness="1"
                                    Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconMods}" Width="13" Height="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Открыть каталог модов" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Открыть addons -->
                            <Button Command="{Binding OpenAddonsFolderCommand}"
                                    Height="40" Padding="14,0" CornerRadius="8"
                                    Background="#121622" BorderBrush="#1F283C" BorderThickness="1"
                                    Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Папка addons" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Прицел Deadlock справа -->
                    <Grid Grid.Column="1" Width="140" Height="140" VerticalAlignment="Center" Margin="20,0,10,0">
                        <Ellipse Width="130" Height="130" Stroke="#10FFFFFF" StrokeThickness="1" />
                        <Ellipse Width="96" Height="96" Stroke="#18FFFFFF" StrokeThickness="1" />
                        <PathIcon Data="{StaticResource IconCrosshair}" Width="78" Height="78" Foreground="#2AFFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. ПЛАШКИ СТАТИСТИКИ СИСТЕМЫ -->
            <Grid ColumnDefinitions="*, *, *">
                <!-- Всего в каталоге -->
                <Border Grid.Column="0" Background="#80111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,10,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCategory}" Width="13" Height="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Доступно модов" FontSize="11" Foreground="#858EA0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalCatalogCount, StringFormat='{}{0} модификаций'}" FontWeight="Black" FontSize="18" Foreground="#FFFFFF" Margin="0,4,0,0" />
                        <TextBlock Text="GameBanana + Deadlocker.net" FontSize="10" Foreground="#555E70" />
                    </StackPanel>
                </Border>

                <!-- Установлено локально -->
                <Border Grid.Column="1" Background="#80111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="5,0,5,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCheckCircle}" Width="13" Height="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Установлено в игре" FontSize="11" Foreground="#858EA0" />
                        </StackPanel>
                        <TextBlock Text="{Binding InstalledCount, StringFormat='{}{0} активно'}" FontWeight="Black" FontSize="18" Foreground="#4ADE80" Margin="0,4,0,0" />
                        <TextBlock Text="Папка game/citadel/addons" FontSize="10" Foreground="#555E70" />
                    </StackPanel>
                </Border>

                <!-- Конфигурация gameinfo.gi -->
                <Border Grid.Column="2" Background="#80111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="10,0,0,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconSettings}" Width="13" Height="13" Foreground="#FFFFFF" />
                            <TextBlock Text="Интеграция Source 2" FontSize="11" Foreground="#858EA0" />
                        </StackPanel>
                        <TextBlock Text="gameinfo.gi: OK" FontWeight="Black" FontSize="18" Foreground="#60A5FA" Margin="0,4,0,0" />
                        <TextBlock Text="Game citadel/addons в SearchPaths" FontSize="10" Foreground="#555E70" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. БЫСТРЫЙ ДОСТУП К МОДАМ ПЕРСОНАЖЕЙ DEADLOCK -->
            <Border Background="#80111522" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="10" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconHeroes}" Width="15" Height="15" Foreground="#FFFFFF" />
                            <TextBlock Text="Модификации по персонажам" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding GoToHeroesCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <TextBlock Text="Все герои" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Vindicta" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconTarget}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Vindicta" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Infernus" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconFlame}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Infernus" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Abrams" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconShield}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Abrams" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Kelvin" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconSparkle}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Kelvin" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Wraith" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconBolt}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Wraith" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Seven" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconBolt}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Seven" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                        <Button Classes="pillCategory" Command="{Binding FilterByHeroCommand}" CommandParameter="Grey Talon" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconTarget}" Width="12" Height="12" Foreground="#FFFFFF" />
                                <TextBlock Text="Grey Talon" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 4. ПОПУЛЯРНОЕ СЕЙЧАС (РЕКОМЕНДУЕМЫЕ МОДЫ) -->
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFlame}" Width="16" Height="16" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="Популярные моды недели" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding GoToCatalogCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <TextBlock Text="Смотреть все" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FeaturedMods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:ModCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
