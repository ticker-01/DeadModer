<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:views="using:DeadModer.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="DeadModer.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="Transparent">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,36" Spacing="28">

            <!-- ========================================================================= -->
            <!-- 1. ГЛАВНЫЙ АРТ-ДЕКО БАННЕР GILDED NOIR С ДИНАМИЧЕСКИМ ГЕРОЕМ              -->
            <!-- ========================================================================= -->
            <Border Background="{StaticResource BrushCardBannerGradient}"
                    BorderBrush="{StaticResource BrushBorderLineGold}"
                    BorderThickness="1.5"
                    CornerRadius="18"
                    Padding="36,28,24,0"
                    ClipToBounds="True"
                    BoxShadow="0 16 48 #60000000">
                <Grid ColumnDefinitions="*, 360">
                    <!-- ЛЕВАЯ КОЛОНКА: ТЕГИ, ТИТУЛЫ, ОПИСАНИЕ И КНОПКИ ДЕЙСТВИЯ -->
                    <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center" Margin="0,0,20,28">
                        <!-- Теги движка и готовности addons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#1FF0A93B" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="5" Height="5" Background="{StaticResource BrushGold}" CornerRadius="1" VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <TextBlock Text="SOURCE 2 ENGINE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" LetterSpacing="1.2" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1A4FE0A8" BorderBrush="{StaticResource BrushSpectralGreenBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center" />
                                    <TextBlock Text="STATUS: ADDONS READY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushSpectralGreen}" LetterSpacing="1.2" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Заголовок DEADLOCK MOD MANAGER (Крупный ар-деко стиль) -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="DEADLOCK"
                                       FontSize="44"
                                       FontWeight="Black"
                                       Foreground="{StaticResource BrushGoldLight}"
                                       LetterSpacing="3.5"
                                       LineHeight="48" />

                            <TextBlock Text="MOD MANAGER"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushBoneText}"
                                       LetterSpacing="4.5"
                                       LineHeight="26" />
                        </StackPanel>

                        <TextBlock Text="Автоматическая установка модов, скинов героев и кастомных звуков в game/citadel/addons с поддержкой pakXX_dir.vpk и адаптацией под патчи."
                                   FontSize="13.5"
                                   Foreground="{StaticResource BrushDimText}"
                                   MaxWidth="560"
                                   LineHeight="21"
                                   TextWrapping="Wrap" />

                        <!-- 3 Кнопки действий -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <!-- Запустить Deadlock (Золотая кнопка) -->
                            <Button Command="{Binding LaunchGameCommand}" Classes="btnGold" Height="44" Padding="22,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" Foreground="#1A1204" VerticalAlignment="Center" />
                                    <TextBlock Text="Запустить Deadlock" Foreground="#1A1204" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Открыть каталог модов (Тёмная кнопка) -->
                            <Button Command="{Binding GoToCatalogCommand}" Classes="btnDark" Height="44" Padding="20,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconMods}" Width="15" Height="15" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                                    <TextBlock Text="Каталог модов" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Папка addons (Тёмная кнопка) -->
                            <Button Command="{Binding OpenAddonsFolderCommand}" Classes="btnDark" Height="44" Padding="16,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                    <TextBlock Text="Папка addons" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ПРАВАЯ КОЛОНКА: ДИНАМИЧЕСКИЙ АРТ ГЕРОЯ (СИСТЕМА АВТОПОДБОРА В ВЫСОКОМ КАЧЕСТВЕ) -->
                    <Grid Grid.Column="1" VerticalAlignment="Bottom" Height="350">
                        <!-- Мягкая аура за героем, адаптирующаяся под цветовую схему персонажа -->
                        <Ellipse Width="340" Height="340"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                 Margin="0,0,0,-30"
                                 Opacity="0.32"
                                 Fill="{Binding BannerAuraBrush}" />

                        <!-- Солнечные лучи / тонкая круглая рамка Deadlock -->
                        <Ellipse Width="290" Height="290" Stroke="{StaticResource BrushBorderLineGold}" StrokeThickness="1" StrokeDashArray="4,4" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" />
                        <Ellipse Width="220" Height="220" Stroke="{StaticResource BrushBorderLine}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />

                        <!-- Высококачественное изображение персонажа (автоматический подбор) -->
                        <Button Command="{Binding PickRandomBannerHeroCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Cursor="Hand" ToolTip.Tip="Нажмите для смены персонажа">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </Button.Styles>
                            <Image Source="{Binding BannerHeroBitmap}"
                                   Stretch="Uniform"
                                   Height="330"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Button>

                        <!-- Верхний золотой бейдж с именем текущего персонажа и кнопкой смены -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Background="#D90E1117"
                                BorderBrush="{StaticResource BrushBorderLineGold}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                BoxShadow="0 4 16 #40000000">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="5" Height="5" Background="{StaticResource BrushGold}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="{Binding BannerHeroDisplayName}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushGoldLight}"
                                           LetterSpacing="1.2"
                                           VerticalAlignment="Center" />
                                <Button Command="{Binding PickRandomBannerHeroCommand}"
                                        Classes="btnIcon"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Cursor="Hand"
                                        ToolTip.Tip="Случайный герой в высоком качестве">
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="11" Height="11" Foreground="{StaticResource BrushBoneText}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- 2. ПЛАШКИ СТАТИСТИКИ СИСТЕМЫ (GILDED NOIR STAT CARDS)                     -->
            <!-- ========================================================================= -->
            <Grid ColumnDefinitions="*, *, *">
                <!-- Всего в каталоге -->
                <Border Grid.Column="0" Background="#11151E" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,12,0">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#181D28" CornerRadius="6">
                                <PathIcon Data="{StaticResource IconCategory}" Width="14" Height="14" Foreground="{StaticResource BrushGoldLight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Доступно модов" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalCatalogCount, StringFormat='{}{0} модификаций'}" FontWeight="Black" FontSize="20" Foreground="{StaticResource BrushBoneText}" Margin="0,4,0,0" />
                        <TextBlock Text="GameBanana + Deadlocker.net" FontSize="11" Foreground="{StaticResource BrushMutedText}" />
                    </StackPanel>
                </Border>

                <!-- Установлено локально -->
                <Border Grid.Column="1" Background="#11151E" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="6,0,6,0">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#182A22" CornerRadius="6">
                                <PathIcon Data="{StaticResource IconCheckCircle}" Width="14" Height="14" Foreground="{StaticResource BrushSpectralGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Установлено в игре" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding InstalledCount, StringFormat='{}{0} активно'}" FontWeight="Black" FontSize="20" Foreground="{StaticResource BrushSpectralGreen}" Margin="0,4,0,0" />
                        <TextBlock Text="Папка game/citadel/addons" FontSize="11" Foreground="{StaticResource BrushMutedText}" />
                    </StackPanel>
                </Border>

                <!-- Конфигурация gameinfo.gi -->
                <Border Grid.Column="2" Background="#11151E" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="12,0,0,0">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#182236" CornerRadius="6">
                                <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{StaticResource BrushSapphireBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Интеграция Source 2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="gameinfo.gi: OK" FontWeight="Black" FontSize="20" Foreground="{StaticResource BrushSapphireBlue}" Margin="0,4,0,0" />
                        <TextBlock Text="Game citadel/addons в SearchPaths" FontSize="11" Foreground="{StaticResource BrushMutedText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- 3. БЫСТРЫЙ ДОСТУП К МОДАМ ПЕРСОНАЖЕЙ DEADLOCK (С РОМБИКАМИ РОЛЕЙ)        -->
            <!-- ========================================================================= -->
            <Border Background="#11151E" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="16" Padding="24,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="7" Height="7" Background="{StaticResource BrushGold}" CornerRadius="1" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Text="Модификации по персонажам" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushBoneText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding GoToHeroesCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <TextBlock Text="Все герои ↗" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                        <!-- Vindicta (Assault - ember) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Vindicta" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushEmberRed}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Vindicta" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Infernus (Assault - ember) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Infernus" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushEmberRed}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Infernus" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Abrams (Defense - sapphire) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Abrams" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushSapphireBlue}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Abrams" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Kelvin (Support - spectral green) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Kelvin" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushSpectralGreen}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Kelvin" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Wraith (Assault - ember) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Wraith" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushEmberRed}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Wraith" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Seven (Control - violet) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Seven" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushViolet}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Seven" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Grey Talon (Assault - ember) -->
                        <Button Classes="pillFilter" Command="{Binding FilterByHeroCommand}" CommandParameter="Grey Talon" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="6" Height="6" Background="{StaticResource BrushEmberRed}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                </Border>
                                <TextBlock Text="Grey Talon" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- 4. ПОПУЛЯРНОЕ СЕЙЧАС (СЕТКА ПОПУЛЯРНЫХ МОДОВ НЕДЕЛИ)                       -->
            <!-- ========================================================================= -->
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="7" Height="7" Background="{StaticResource BrushGold}" CornerRadius="1" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock Text="Популярные моды недели" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding GoToCatalogCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <TextBlock Text="Смотреть все ↗" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Сетка карточек популярных модов -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FeaturedMods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:ModCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>