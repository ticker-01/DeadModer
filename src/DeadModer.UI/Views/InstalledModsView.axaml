<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="750"
             x:Class="DeadModer.UI.Views.InstalledModsView"
             x:DataType="vm:InstalledModsViewModel"
             Background="Transparent">

    <Design.DataContext>
        <vm:InstalledModsViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" Spacing="24">
            <!-- ВЕРХНЯЯ СВОДКА И СТАТИСТИКА В СТИЛЕ GILDED NOIR -->
            <Border Background="{StaticResource BrushCardBannerGradient}" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1" CornerRadius="18" Padding="28,24">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                        <!-- Заголовок страницы -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Rectangle Width="8" Height="8" Fill="{StaticResource BrushGold}" VerticalAlignment="Center">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <TextBlock Text="{Binding Loc[MyMods_Title]}"
                                       FontFamily="{StaticResource FontOswald}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource BrushGoldLight}"
                                       LetterSpacing="0.04"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Loc[MyMods_Subtitle]}" FontSize="13" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                        
                        <!-- ПЛАШКИ СТАТИСТИКИ -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" VerticalAlignment="Center">
                            <!-- Всего -->
                            <Border Background="#0E1117" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="12" Padding="18,12" MinWidth="120">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Loc[Stat_Total]}" FontSize="11" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalInstalledCount}"
                                               FontFamily="{StaticResource FontOswald}"
                                               FontWeight="Bold" FontSize="22"
                                               Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Активно -->
                            <Border Background="#0C1B14" BorderBrush="{StaticResource BrushSpectralGreen}" BorderThickness="1" CornerRadius="12" Padding="18,12" MinWidth="120">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Loc[Stat_Active]}" FontSize="11" Foreground="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EnabledCount}"
                                               FontFamily="{StaticResource FontOswald}"
                                               FontWeight="Bold" FontSize="22"
                                               Foreground="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Занято места -->
                            <Border Background="#0E1117" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="12" Padding="18,12" MinWidth="130">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Loc[Stat_Storage]}" FontSize="11" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalStorageUsedFormatted}"
                                               FontFamily="{StaticResource FontOswald}"
                                               FontWeight="Bold" FontSize="22"
                                               Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- КНОПКИ ДЕЙСТВИЙ (ОТКРЫТЬ ADDONS, СИНХРОНИЗИРОВАТЬ, ПОЧИНИТЬ МОДЫ) -->
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                        <Button Command="{Binding OpenAddonsFolderCommand}"
                                Classes="btnDark" Height="36" Padding="18,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc[Btn_OpenAddons]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SyncAddonsFolderCommand}"
                                Classes="btnGold" Height="36" Padding="18,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="#1A1204" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc[Btn_Sync]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding FixAllModsCommand}"
                                IsEnabled="{Binding !IsFixingMods}"
                                Classes="btnDark" Height="36" Padding="18,0"
                                ToolTip.Tip="Удалить устаревшие скрипты .vdata_c, синхронизировать скелеты и адаптировать модели .vmdl_c под последний патч Deadlock">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSparkle}" Width="13" Height="13" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc[Btn_FixMods]}" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- СТАТУС ВОССТАНОВЛЕНИЯ СОВМЕСТИМОСТИ МОДОВ -->
            <Border IsVisible="{Binding FixStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#0E1724" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconSparkle}" Width="16" Height="16" Foreground="{StaticResource BrushGold}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" Text="{Binding FixStatusMessage}" FontSize="13" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="100" Height="4" Foreground="{StaticResource BrushGold}" IsVisible="{Binding IsFixingMods}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
            </Border>

            <!-- ПАНЕЛЬ МАССОВЫХ ДЕЙСТВИЙ -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Rectangle Width="8" Height="8" Fill="{StaticResource BrushGold}" VerticalAlignment="Center">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="УСТАНОВЛЕННЫЕ МОДИФИКАЦИИ"
                               FontFamily="{StaticResource FontOswald}"
                               FontWeight="Bold" FontSize="18"
                               Foreground="{StaticResource BrushBoneText}"
                               LetterSpacing="0.04"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleAllModsCommand}" 
                            Height="32" Padding="16,0" CornerRadius="8"
                            BorderBrush="{StaticResource BrushSpectralGreen}" BorderThickness="1"
                            Background="#10251B" Foreground="{StaticResource BrushSpectralGreen}" FontSize="12" FontWeight="SemiBold"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Cursor="Hand">
                        <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
                        <TextBlock Text="{Binding Loc[Btn_EnableAll]}" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding ToggleAllModsCommand}" 
                            Height="32" Padding="16,0" CornerRadius="8"
                            BorderBrush="#502028" BorderThickness="1"
                            Background="#221216" Foreground="{StaticResource BrushEmberRed}" FontSize="12" FontWeight="SemiBold"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Cursor="Hand">
                        <Button.CommandParameter><x:Boolean>False</x:Boolean></Button.CommandParameter>
                        <TextBlock Text="{Binding Loc[Btn_DisableAll]}" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- СПИСОК УСТАНОВЛЕННЫХ МОДОВ -->
            <ItemsControl ItemsSource="{Binding InstalledMods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushInk1}" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                CornerRadius="14" Padding="16,12" Margin="0,0,0,10">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="#161B26" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLineGold}" />
                                </Style>
                            </Border.Styles>

                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto, Auto">
                                <!-- Индикатор формата VPK (Моно-тайл в стиле Gilded Noir) -->
                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="#141822" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1"
                                        CornerRadius="10" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="VPK"
                                               FontFamily="{StaticResource FontOswald}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource BrushGoldLight}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Название, описание и версия -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource FontOswald}"
                                                   FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                        <Border Background="#1C1810" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version, StringFormat='{}v{0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushDimText}" TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Дата установки -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="{Binding Loc[Col_Date]}" FontSize="10" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DateFormatted}" FontSize="12" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Размер файла -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="{Binding Loc[Col_Size]}" FontSize="10" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Переключатель Вкл/Выкл -->
                                <Button Grid.Column="4" 
                                        Command="{Binding InstallOrToggleCommand}"
                                        Height="30" Padding="14,0" CornerRadius="8"
                                        FontSize="12" FontWeight="SemiBold"
                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                        Classes.enabled="{Binding IsEnabled}"
                                        Classes.disabled="{Binding !IsEnabled}"
                                        VerticalAlignment="Center" Margin="14,0" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button.enabled">
                                            <Setter Property="Background" Value="#12241C" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushSpectralGreen}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushSpectralGreen}" />
                                        </Style>
                                        <Style Selector="Button.disabled">
                                            <Setter Property="Background" Value="#141822" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLine}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushDimText}" />
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="{StaticResource BrushSpectralGreen}" IsVisible="{Binding IsEnabled}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Кнопка выбора для инспектора / инфо -->
                                <Button Grid.Column="5"
                                        Command="{Binding SelectCommand}"
                                        Classes="btnDark" Height="30" Padding="12,0" CornerRadius="8"
                                        FontSize="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Инфо" VerticalAlignment="Center" />
                                </Button>

                                <!-- КНОПКА УДАЛИТЬ МОД (Ember Red) -->
                                <Button Grid.Column="6"
                                        Command="{Binding $parent[UserControl].((vm:InstalledModsViewModel)DataContext).DeleteModCommand}"
                                        CommandParameter="{Binding}"
                                        Height="30" Padding="12,0" CornerRadius="8"
                                        Background="#221216" BorderBrush="#502028" BorderThickness="1"
                                        Foreground="{StaticResource BrushEmberRed}" FontSize="12" FontWeight="SemiBold"
                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip.Tip="Удалить файл мода (.vpk) из игры">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" Foreground="{StaticResource BrushEmberRed}" VerticalAlignment="Center" />
                                        <TextBlock Text="Удалить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
