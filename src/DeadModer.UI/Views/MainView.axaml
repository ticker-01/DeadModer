<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:views="using:DeadModer.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="DeadModer.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="#0A0C12">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:ModCatalogViewModel">
            <views:ModCatalogView />
        </DataTemplate>
        <DataTemplate DataType="vm:InstalledModsViewModel">
            <views:InstalledModsView />
        </DataTemplate>
        <DataTemplate DataType="vm:HeroesViewModel">
            <views:HeroesView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="#141926" />
            <Setter Property="BorderBrush" Value="#222C40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tabBtn.active">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 1. АТМОСФЕРНЫЙ ФОН GILDED NOIR (AURORA BLOBS + ТЕКСТУРА ГОРОДА + ДИВНЫЙ ГРАДИЕНТ) -->
        <!-- Базовый тёмный фон ink0 -->
        <Border Background="#08090C" />

        <!-- Мягкие размытые круги Aurora (блок b1, b2, b3 по спецификации) -->
        <Grid>
            <!-- Блок b1: #14876a (изумрудный spectral) в левом верхнем углу -->
            <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-180,0,0" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Offset="0.0" Color="#4FE0A8" />
                        <GradientStop Offset="0.5" Color="#14876A" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Блок b2: #b8581b (тёплый янтарь / ember) в правом верхнем углу -->
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,100,-120,0" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Offset="0.0" Color="#F0A93B" />
                        <GradientStop Offset="0.5" Color="#B8581B" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Блок b3: #2b43a6 (мистический сапфир) в нижней части -->
            <Ellipse Width="650" Height="650" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-300" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Offset="0.0" Color="#6B9BFF" />
                        <GradientStop Offset="0.5" Color="#2B43A6" />
                        <GradientStop Offset="1.0" Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Атмосферное текстурное изображение города с низкой прозрачностью -->
        <Image Source="{Binding CurrentBackgroundImage}" Stretch="UniformToFill" Opacity="0.18" />

        <!-- Нуар-виньетка для глубокого контраста ар-деко -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="50%,35%" GradientOrigin="50%,35%" RadiusX="80%" RadiusY="80%">
                    <GradientStop Offset="0.0" Color="#0008090C" />
                    <GradientStop Offset="0.5" Color="#6608090C" />
                    <GradientStop Offset="1.0" Color="#D908090C" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="60, *">
            <!-- 3. ВЕРХНИЙ ХЕДЕР ПРИЛОЖЕНИЯ (GILDED NOIR TOPBAR) -->
            <Border Grid.Row="0" Background="#F20E1117" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Логотип приложения Deadlock в золотом стиле -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="#141822" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1.5" CornerRadius="10">
                            <PathIcon Data="{StaticResource IconCrosshair}" Width="18" Height="18" Foreground="{StaticResource BrushGoldLight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="DEADMODER" FontWeight="Black" FontSize="14" LetterSpacing="2.5" Foreground="{StaticResource BrushGoldLight}" />
                                <Border Width="5" Height="5" Background="{StaticResource BrushGold}" CornerRadius="1" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Loc[App_Subtitle]}" FontSize="10" Foreground="{StaticResource BrushDimText}" LetterSpacing="0.5" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Статус игры, профиль, настройки и язык -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Индикатор статуса Deadlock со спектральной зелёной точкой -->
                        <Border Background="#104FE0A8" BorderBrush="#404FE0A8" BorderThickness="1" CornerRadius="999" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GameStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#D1FAE5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Золотая кнопка запуска Deadlock через Steam (btnGold) -->
                        <Button Command="{Binding LaunchDeadlockCommand}" Classes="btnGold" Height="36" Padding="16,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="#1A1204" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc[Btn_LaunchGame]}" Foreground="#1A1204" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Переключатель языка RU / EN (Сегментная кнопка) -->
                        <Border Background="#0A0D14" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="10" Height="36" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleLanguageCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="10,0" Height="34"
                                    Cursor="Hand" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconTranslate}" Width="12" Height="12" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                    <TextBlock Text="RU" Classes.active="{Binding Loc.IsRussian}" Classes.inactive="{Binding !Loc.IsRussian}" VerticalAlignment="Center">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.active"><Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" /><Setter Property="FontWeight" Value="Bold" /></Style>
                                            <Style Selector="TextBlock.inactive"><Setter Property="Foreground" Value="{StaticResource BrushDimText}" /></Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <TextBlock Text="/" Foreground="#454A56" VerticalAlignment="Center" />
                                    <TextBlock Text="EN" Classes.active="{Binding Loc.IsEnglish}" Classes.inactive="{Binding !Loc.IsEnglish}" VerticalAlignment="Center">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.active"><Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" /><Setter Property="FontWeight" Value="Bold" /></Style>
                                            <Style Selector="TextBlock.inactive"><Setter Property="Foreground" Value="{StaticResource BrushDimText}" /></Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Кнопка профиля / аккаунтов на сайтах модов -->
                        <Button Command="{Binding OpenAccountsCommand}"
                                Height="36" Padding="12,0" CornerRadius="999"
                                BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                Background="#0D1118" Foreground="{StaticResource BrushBoneText}"
                                Cursor="Hand" ToolTip.Tip="Управление аккаунтом и симуляцией (GameBanana / Deadlocker)"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushGoldGradient}" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconAccountCircle}" Width="14" Height="14" Foreground="#1A1204" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding UserDisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushBoneText}" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSpectralGreen}" IsVisible="{Binding IsAuthenticated}" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.Tip="Аккаунт верифицирован (доступ ко всем модам)" />
                            </StackPanel>
                        </Button>

                        <!-- Иконка настроек (.btnIcon) -->
                        <Button Command="{Binding NavigateCommand}" Classes="btnIcon" Width="36" Height="36"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Настройки">
                            <Button.CommandParameter>
                                <x:Static Member="vm:NavigationTab.Settings" />
                            </Button.CommandParameter>
                            <PathIcon Data="{StaticResource IconSettings}" Width="15" Height="15" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. ОСНОВНОЙ КОНТЕНТ (ЛЕВЫЙ САЙДБАР 240px И ПОЛНОРАЗМЕРНЫЙ ЭКРАН) -->
            <Grid Grid.Row="1" ColumnDefinitions="240, *">

                <!-- 4.1 ЛЕВЫЙ САЙДБАР (GILDED NOIR SIDEBAR 240PX) -->
                <Border Grid.Column="0" Background="{StaticResource BrushSidebarGradient}" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*, Auto">
                        <!-- Элементы навигации -->
                        <StackPanel Grid.Row="0" Margin="14,18" Spacing="6">
                            <!-- Главная -->
                            <Button Classes="sidebarNav" Classes.active="{Binding IsHomeTab}"
                                    Command="{Binding NavigateCommand}">
                                <Button.CommandParameter>
                                    <x:Static Member="vm:NavigationTab.Home" />
                                </Button.CommandParameter>
                                <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconHome}" Width="17" Height="17" />
                                        <TextBlock Text="{Binding Loc[Nav_Home]}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Золотой ромбик активного пункта -->
                                    <Border Grid.Column="2" Width="7" Height="7" Background="{StaticResource BrushGold}"
                                            CornerRadius="1" IsVisible="{Binding IsHomeTab}" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Моды -->
                            <Button Classes="sidebarNav" Classes.active="{Binding IsModsTab}"
                                    Command="{Binding NavigateCommand}">
                                <Button.CommandParameter>
                                    <x:Static Member="vm:NavigationTab.Mods" />
                                </Button.CommandParameter>
                                <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconMods}" Width="17" Height="17" />
                                        <TextBlock Text="{Binding Loc[Nav_Mods]}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="7" Height="7" Background="{StaticResource BrushGold}"
                                            CornerRadius="1" IsVisible="{Binding IsModsTab}" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Герои -->
                            <Button Classes="sidebarNav" Classes.active="{Binding IsHeroesTab}"
                                    Command="{Binding NavigateCommand}">
                                <Button.CommandParameter>
                                    <x:Static Member="vm:NavigationTab.Heroes" />
                                </Button.CommandParameter>
                                <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconHeroes}" Width="17" Height="17" />
                                        <TextBlock Text="{Binding Loc[Nav_Heroes]}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="7" Height="7" Background="{StaticResource BrushGold}"
                                            CornerRadius="1" IsVisible="{Binding IsHeroesTab}" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Мои моды -->
                            <Button Classes="sidebarNav" Classes.active="{Binding IsMyModsTab}"
                                    Command="{Binding NavigateCommand}">
                                <Button.CommandParameter>
                                    <x:Static Member="vm:NavigationTab.MyMods" />
                                </Button.CommandParameter>
                                <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconMyMods}" Width="17" Height="17" />
                                        <TextBlock Text="{Binding Loc[Nav_MyMods]}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="7" Height="7" Background="{StaticResource BrushGold}"
                                            CornerRadius="1" IsVisible="{Binding IsMyModsTab}" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Настройки -->
                            <Button Classes="sidebarNav" Classes.active="{Binding IsSettingsTab}"
                                    Command="{Binding NavigateCommand}">
                                <Button.CommandParameter>
                                    <x:Static Member="vm:NavigationTab.Settings" />
                                </Button.CommandParameter>
                                <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconSettings}" Width="17" Height="17" />
                                        <TextBlock Text="{Binding Loc[Nav_Settings]}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="7" Height="7" Background="{StaticResource BrushGold}"
                                            CornerRadius="1" IsVisible="{Binding IsSettingsTab}" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="45" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Нижний блок Deadlock с эмблемой (side-foot по спецификации) -->
                        <Border Grid.Row="1" Margin="14,16" Padding="16,14" Background="#121620" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconCrosshair}" Width="18" Height="18" Foreground="{StaticResource BrushGoldLight}" HorizontalAlignment="Left" />
                                    <TextBlock Text="DEADLOCK" FontWeight="Black" FontSize="13" Foreground="{StaticResource BrushGoldLight}" LetterSpacing="1.2" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Ар-деко и оккультный нуар." FontSize="10.5" Foreground="{StaticResource BrushDimText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSpectralGreen}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Loc[App_Version]}" FontSize="10" Foreground="{StaticResource BrushDimText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4.2 ЦЕНТРАЛЬНЫЙ ДИНАМИЧЕСКИЙ КОНТЕНТ (КАТАЛОГ / ГЕРОИ / МОИ МОДЫ) -->
                <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}" />
            </Grid>
        </Grid>

        <!-- 5. МОДАЛЬНОЕ ОКНО: РЕГИСТРАЦИЯ, ВХОД И СИМУЛЯЦИЯ АККАУНТОВ НА САЙТАХ МОДОВ -->
        <Grid Background="#D005070B" IsVisible="{Binding IsAccountsModalOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="560" MaxHeight="720" Background="#11151E" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1.5" CornerRadius="16" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 #E0000000">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Заголовок модального окна -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="40" Height="40" Background="#181D28" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1" CornerRadius="10">
                                    <PathIcon Data="{StaticResource IconAccountCircle}" Width="20" Height="20" Foreground="{StaticResource BrushGoldLight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Аккаунты сайтов модификаций" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushBoneText}" />
                                    <TextBlock Text="Привязка и регистрация на официальных сайтах GameBanana и Deadlocker" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding CloseAccountsCommand}" Classes="btnIcon" Width="32" Height="32">
                                <PathIcon Data="{StaticResource IconClose}" Width="13" Height="13" Foreground="{StaticResource BrushDimText}" />
                            </Button>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BrushBorderLine}" Margin="0,-4,0,0" />

                        <!-- БЛОК АКТИВНОГО ПРОФИЛЯ (ЕСЛИ АВТОРИЗОВАН) -->
                        <Border Background="#104FE0A8" BorderBrush="{StaticResource BrushSpectralGreenBorder}" BorderThickness="1" CornerRadius="12" Padding="14"
                                IsVisible="{Binding IsAuthenticated}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" Background="#1A4FE0A8" CornerRadius="20">
                                        <PathIcon Data="{StaticResource IconCheckCircle}" Width="20" Height="20" Foreground="{StaticResource BrushSpectralGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="Bold" FontSize="14" Foreground="#F0FDF4" />
                                            <Border Background="#1A4FE0A8" BorderBrush="{StaticResource BrushSpectralGreenBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsGameBananaAuthenticated}">
                                                <TextBlock Text="GameBanana" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushSpectralGreen}" />
                                            </Border>
                                            <Border Background="#1A6B9BFF" BorderBrush="{StaticResource BrushSapphireBlueBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsDeadlockerAuthenticated}">
                                                <TextBlock Text="Deadlocker" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushSapphireBlue}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Сайты подключены: Полный каталог модов открыт, комментарии активны" FontSize="11" Foreground="{StaticResource BrushSpectralGreen}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding LogoutAccountCommand}" Classes="btnDark" Height="32" Padding="12,0" FontSize="11">
                                    <TextBlock Text="Отключить все" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ПЕРЕКЛЮЧАТЕЛЬ САЙТОВ: [ GameBanana.com ] | [ Deadlocker.net ] -->
                        <Grid ColumnDefinitions="*, 8, *">
                            <Button Grid.Column="0" Command="{Binding SetAccountModeCommand}" CommandParameter="0"
                                    Classes="tabBtn" Classes.active="{Binding IsModeGameBanana}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="GameBanana.com" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding SetAccountModeCommand}" CommandParameter="1"
                                    Classes="tabBtn" Classes.active="{Binding IsModeDeadlocker}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Deadlocker.net" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 1. ВКЛАДКА GAMEBANANA -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsModeGameBanana}">
                            <!-- Официальные действия в браузере -->
                            <Border Background="#0A0D14" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Официальные страницы GameBanana в браузере:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushDimText}" />
                                    <Grid ColumnDefinitions="*, 8, *">
                                        <Button Grid.Column="0" Command="{Binding OpenGameBananaRegisterCommand}" Classes="btnDark" Height="34" FontSize="11">
                                            <TextBlock Text="Регистрация на GameBanana" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding OpenGameBananaLoginCommand}" Classes="btnDark" Height="34" FontSize="11">
                                            <TextBlock Text="Вход на GameBanana" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Привязка аккаунта в приложении -->
                            <Border Background="#0E121A" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Привязать аккаунт GameBanana в DeadModer" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushBoneText}" />
                                    <TextBlock Text="Подключите свой никнейм GameBanana для доступа ко всем закрытым модам и оставления отзывов." FontSize="11" Foreground="{StaticResource BrushDimText}" TextWrapping="Wrap" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Никнейм игрока на GameBanana" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                        <TextBox Text="{Binding GameBananaUsername, Mode=TwoWay}"
                                                 PlaceholderText="Ваш никнейм на GameBanana..."
                                                 Height="36" CornerRadius="8" Background="#07090D" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                 Foreground="{StaticResource BrushBoneText}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Email (необязательно)" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                        <TextBox Text="{Binding GameBananaEmail, Mode=TwoWay}"
                                                 PlaceholderText="your-email@example.com..."
                                                 Height="36" CornerRadius="8" Background="#07090D" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                 Foreground="{StaticResource BrushBoneText}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="API-токен или пароль профиля (необязательно)" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                        <TextBox Text="{Binding GameBananaPassword, Mode=TwoWay}" PasswordChar="*"
                                                 PlaceholderText="Для подтверждения подписи..."
                                                 Height="36" CornerRadius="8" Background="#07090D" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                 Foreground="{StaticResource BrushBoneText}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Command="{Binding ConnectGameBananaCommand}" Classes="btnGold" Height="38" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="#1A1204" VerticalAlignment="Center" />
                                                <TextBlock Text="Подключить аккаунт GameBanana" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding DisconnectGameBananaCommand}"
                                                 IsVisible="{Binding IsGameBananaAuthenticated}" Classes="btnDark"
                                                 Height="38" Margin="8,0,0,0" Padding="14,0" Foreground="{StaticResource BrushEmberRed}" FontSize="11">
                                            <TextBlock Text="Отключить" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2. ВКЛАДКА DEADLOCKER.NET -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsModeDeadlocker}">
                            <!-- Официальные действия в браузере -->
                            <Border Background="#0A0D14" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Официальные страницы Deadlocker.net в браузере:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushDimText}" />
                                    <Grid ColumnDefinitions="*, 8, *">
                                        <Button Grid.Column="0" Command="{Binding OpenDeadlockerRegisterCommand}" Classes="btnDark" Height="34" FontSize="11">
                                            <TextBlock Text="Регистрация на Deadlocker" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding OpenDeadlockerLoginCommand}" Classes="btnDark" Height="34" FontSize="11">
                                            <TextBlock Text="Вход на Deadlocker" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Привязка аккаунта в приложении -->
                            <Border Background="#0E121A" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Привязать аккаунт Deadlocker.net в DeadModer" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushBoneText}" />
                                    <TextBlock Text="Подключите свой никнейм Deadlocker для доступа к эксклюзивным модам и отправки комментариев." FontSize="11" Foreground="{StaticResource BrushDimText}" TextWrapping="Wrap" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Никнейм игрока на Deadlocker" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                        <TextBox Text="{Binding DeadlockerUsername, Mode=TwoWay}"
                                                 PlaceholderText="Ваш никнейм на Deadlocker..."
                                                 Height="36" CornerRadius="8" Background="#07090D" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                 Foreground="{StaticResource BrushBoneText}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Email (необязательно)" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                        <TextBox Text="{Binding DeadlockerEmail, Mode=TwoWay}"
                                                 PlaceholderText="your-email@example.com..."
                                                 Height="36" CornerRadius="8" Background="#07090D" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                 Foreground="{StaticResource BrushBoneText}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Токен сессии или пароль (необязательно)" FontSize="11" Foreground="{StaticResource BrushDimText}" />
                                        <TextBox Text="{Binding DeadlockerPassword, Mode=TwoWay}" PasswordChar="*"
                                                 PlaceholderText="Для подтверждения сессии..."
                                                 Height="36" CornerRadius="8" Background="#07090D" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                                 Foreground="{StaticResource BrushBoneText}" FontSize="12" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Command="{Binding ConnectDeadlockerCommand}" Classes="btnGold" Height="38" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="#1A1204" VerticalAlignment="Center" />
                                                <TextBlock Text="Подключить аккаунт Deadlocker" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding DisconnectDeadlockerCommand}"
                                                 IsVisible="{Binding IsDeadlockerAuthenticated}" Classes="btnDark"
                                                 Height="38" Margin="8,0,0,0" Padding="14,0" Foreground="{StaticResource BrushEmberRed}" FontSize="11">
                                            <TextBlock Text="Отключить" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Статус сообщения -->
                        <TextBlock Text="{Binding AccountsStatusMessage}" Foreground="{StaticResource BrushSpectralGreen}" FontSize="12" HorizontalAlignment="Center"
                                   IsVisible="{Binding AccountsStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Кнопка закрытия -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Button Grid.Column="1" Command="{Binding CloseAccountsCommand}" Classes="btnDark" Height="36" Padding="20,0" FontSize="12">
                                <TextBlock Text="Закрыть" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

