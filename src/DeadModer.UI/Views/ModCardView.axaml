<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="205" d:DesignHeight="245"
             x:Class="DeadModer.UI.Views.ModCardView"
             x:DataType="vm:ModCardViewModel"
             IsVisible="{Binding IsVisible}">

    <Design.DataContext>
        <vm:ModCardViewModel />
    </Design.DataContext>

    <!-- КНОПКА-КОНТЕЙНЕР ДЛЯ ОТКРЫТИЯ СТРАНИЦЫ МОДА (MOCKUP 2) -->
    <Button Command="{Binding OpenDetailCommand}"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Button.Styles>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Button.Styles>

        <Border Background="#85121624"
                BorderBrush="#1E2638"
                BorderThickness="1"
                CornerRadius="8"
                Width="195"
                Height="240"
                ClipToBounds="True">
            <Border.Styles>
                <Style Selector="Border:pointerover">
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                    <Setter Property="Background" Value="#95161C2C" />
                </Style>
            </Border.Styles>

            <Grid RowDefinitions="95, *">
                <!-- ВЕРХ: ПРЕВЬЮ СКРИНШОТ МОДА -->
                <Border Grid.Row="0" Background="#141824" ClipToBounds="True">
                    <Grid>
                        <!-- Изображение мода -->
                        <Image Source="{Binding PreviewBitmap}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!-- Фон по умолчанию (если превью нет) -->
                        <Grid Background="#161B28" IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                            <PathIcon Data="{StaticResource IconMods}" Width="24" Height="24" Foreground="#2A3750"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Полупрозрачное затемнение картинки -->
                        <Border Background="#35000000" />

                        <!-- Верхний ряд: Категория слева, бейджи, три точки меню справа -->
                        <Grid Margin="8,6" VerticalAlignment="Top" ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                <Border Background="#D00B0E17" BorderBrush="#202A3C" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                </Border>

                                <!-- Бейдж выбора редакции (Featured) -->
                                <Border Background="#E03D2E0B" BorderBrush="#785315" BorderThickness="1"
                                        CornerRadius="4" Padding="4,2"
                                        IsVisible="{Binding IsFeatured}"
                                        ToolTip.Tip="Выбор редакции">
                                    <TextBlock Text="Топ" FontSize="8" FontWeight="Bold" Foreground="#FBBF24" />
                                </Border>

                                <!-- Бейдж 18+ (NSFW) -->
                                <Border Background="#E0421212" BorderBrush="#7F1D1D" BorderThickness="1"
                                        CornerRadius="4" Padding="4,2"
                                        IsVisible="{Binding IsNsfw}"
                                        ToolTip.Tip="Возрастное ограничение 18+">
                                    <TextBlock Text="18+" FontSize="8" FontWeight="Bold" Foreground="#EF4444" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" HorizontalAlignment="Right"
                                    Background="#D00B0E17" CornerRadius="4" Width="20" Height="20">
                                <PathIcon Data="{StaticResource IconDotsVertical}" Width="10" Height="10" Foreground="#858EA0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- НИЗ: НАЗВАНИЕ, ОПИСАНИЕ, СТАТИСТИКА И КНОПКА ДЕЙСТВИЯ -->
                <Border Grid.Row="1" Padding="10,8" Background="#800E121E">
                    <Grid RowDefinitions="Auto, *, Auto, Auto">
                        <!-- Название мода -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Краткое описание мода (2 строки) -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Description}"
                                   FontSize="10"
                                   Foreground="#717A8C"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   LineHeight="14"
                                   Margin="0,2,0,4" />

                        <!-- Статистика: Загрузки и рейтинг -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,6">
                            <!-- Загрузки -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconDownloadMini}" Width="10" Height="10" Foreground="#CBD5E1" />
                                <TextBlock Text="{Binding DownloadCountFormatted}" FontSize="10" Foreground="#858EA0" />
                            </StackPanel>

                            <!-- Разделитель -->
                            <TextBlock Grid.Column="1" Text="•" FontSize="10" Foreground="#334155" Margin="5,0" VerticalAlignment="Center" />

                            <!-- Рейтинг -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconStar}" Width="10" Height="10" Foreground="#FFFFFF" />
                                <TextBlock Text="4.8" FontSize="10" FontWeight="SemiBold" Foreground="#858EA0" />
                            </StackPanel>
                        </Grid>

                        <!-- Кнопка действия (Установить / Установлен) -->
                        <Grid Grid.Row="3">
                            <!-- Прогресс-бар при скачивании -->
                            <ProgressBar IsVisible="{Binding IsInstalling}"
                                         Value="{Binding InstallProgress}"
                                         Minimum="0" Maximum="1"
                                         Height="2"
                                         Foreground="#2563EB" Background="#161B28"
                                         BorderThickness="0" Margin="0,0,0,4"
                                         VerticalAlignment="Top" />

                            <!-- Кнопка действия -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="28" CornerRadius="6"
                                    Command="{Binding InstallOrToggleCommand}"
                                    Classes.installed="{Binding IsInstalled}"
                                    Classes.notInstalled="{Binding !IsInstalled}">
                                <Button.Styles>
                                    <Style Selector="Button.installed">
                                        <Setter Property="Background" Value="#10251B" />
                                        <Setter Property="BorderBrush" Value="#1E442F" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="#4ADE80" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                    <Style Selector="Button.notInstalled">
                                        <Setter Property="Background" Value="#161C2C" />
                                        <Setter Property="BorderBrush" Value="#25324A" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="#CBD5E1" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="10" Height="10" Foreground="#4ADE80" IsVisible="{Binding IsInstalled}" />
                                    <TextBlock Text="{Binding ActionButtonText}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Button>
</UserControl>
