<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeadModer.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="276"
             x:Class="DeadModer.UI.Views.ModCardView"
             x:DataType="vm:ModCardViewModel"
             IsVisible="{Binding IsVisible}">

    <Design.DataContext>
        <vm:ModCardViewModel />
    </Design.DataContext>

    <!-- КНОПКА-КОНТЕЙНЕР ДЛЯ ОТКРЫТИЯ ДЕТАЛЬНОЙ СТРАНИЦЫ МОДА -->
    <Button Command="{Binding OpenDetailCommand}"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Cursor="Hand">
        <Button.Styles>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Button.Styles>

        <!-- КАРТОЧКА GILDED NOIR С ЗОЛОТЫМИ АКЦЕНТАМИ И УГОЛКАМИ -->
        <Border Background="{StaticResource BrushCardGradient}"
                BorderBrush="{StaticResource BrushBorderLine}"
                BorderThickness="1.2"
                CornerRadius="16"
                Width="220"
                Height="276"
                ClipToBounds="True">
            <Border.Styles>
                <Style Selector="Border:pointerover">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLineGold}" />
                    <Setter Property="Background" Value="{StaticResource BrushInkCardHover}" />
                </Style>
            </Border.Styles>

            <Grid RowDefinitions="115, *">
                <!-- ВЕРХ: ПРЕВЬЮ СКРИНШОТ МОДА (ДИНАМИЧЕСКАЯ ЗАГРУЗКА ИЗ СЕТИ / КЭША) -->
                <Border Grid.Row="0" Background="#0B0D12" ClipToBounds="True">
                    <Grid>
                        <!-- 1. Динамическое изображение мода (ImageCacheService) -->
                        <Image Source="{Binding PreviewBitmap}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!-- 2. Благородный нуар-плейсхолдер (если превью ещё загружается или отсутствует) -->
                        <Grid Background="#0D1017" IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                            <Ellipse Width="70" Height="70" Stroke="{StaticResource BrushBorderLineGold}" StrokeThickness="1" StrokeDashArray="3,3" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" />
                            <PathIcon Data="{StaticResource IconMods}" Width="26" Height="26" Foreground="{StaticResource BrushGoldLight}" Opacity="0.4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 3. Мягкое нижнее затемнение для читаемости тегов -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0.0" Color="#1008090C" />
                                    <GradientStop Offset="0.6" Color="#3008090C" />
                                    <GradientStop Offset="1.0" Color="#D008090C" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 4. Верхний ряд: Категория слева, бейджи, меню справа -->
                        <Grid Margin="10,8" VerticalAlignment="Top" ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Left">
                                <!-- Категория (Gold Tag) -->
                                <Border Background="#CC08090C" BorderBrush="{StaticResource BrushBorderLineGold}" BorderThickness="1"
                                        CornerRadius="6" Padding="7,2">
                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" LetterSpacing="0.8" />
                                </Border>

                                <!-- Бейдж выбора редакции (Featured) -->
                                <Border Background="#D03D2E0B" BorderBrush="{StaticResource BrushGold}" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2"
                                        IsVisible="{Binding IsFeatured}"
                                        ToolTip.Tip="Выбор редакции">
                                    <TextBlock Text="ТОП" FontSize="8.5" FontWeight="Black" Foreground="{StaticResource BrushGoldLight}" />
                                </Border>

                                <!-- Бейдж 18+ (NSFW) -->
                                <Border Background="#D0421212" BorderBrush="{StaticResource BrushEmberRedBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2"
                                        IsVisible="{Binding IsNsfw}"
                                        ToolTip.Tip="Возрастное ограничение 18+">
                                    <TextBlock Text="18+" FontSize="8.5" FontWeight="Black" Foreground="{StaticResource BrushEmberRed}" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" HorizontalAlignment="Right"
                                    Background="#CC08090C" BorderBrush="{StaticResource BrushBorderLine}" BorderThickness="1"
                                    CornerRadius="6" Width="22" Height="22">
                                <PathIcon Data="{StaticResource IconDotsVertical}" Width="11" Height="11" Foreground="{StaticResource BrushDimText}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- НИЗ: НАЗВАНИЕ, ОПИСАНИЕ, СТАТИСТИКА И КНОПКА ДЕЙСТВИЯ -->
                <Border Grid.Row="1" Padding="12,10" Background="#F00D1016">
                    <Grid RowDefinitions="Auto, *, Auto, Auto">
                        <!-- Название мода -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="{StaticResource BrushBoneText}"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Краткое описание мода (2 строки) -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Description}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource BrushDimText}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   LineHeight="15"
                                   Margin="0,3,0,6" />

                        <!-- Статистика: Загрузки и рейтинг -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                            <!-- Загрузки -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconDownloadMini}" Width="10" Height="10" Foreground="{StaticResource BrushDimText}" />
                                <TextBlock Text="{Binding DownloadCountFormatted}" FontSize="10.5" Foreground="{StaticResource BrushDimText}" />
                            </StackPanel>

                            <!-- Разделитель -->
                            <TextBlock Grid.Column="1" Text="•" FontSize="10" Foreground="{StaticResource BrushBorderLine}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Рейтинг -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconStar}" Width="10" Height="10" Foreground="{StaticResource BrushGold}" />
                                <TextBlock Text="4.8" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" />
                            </StackPanel>
                        </Grid>

                        <!-- Кнопка действия (Установить / Установлен) -->
                        <Grid Grid.Row="3">
                            <!-- Прогресс-бар при скачивании -->
                            <ProgressBar IsVisible="{Binding IsInstalling}"
                                         Value="{Binding InstallProgress}"
                                         Minimum="0" Maximum="1"
                                         Height="3"
                                         Foreground="{StaticResource BrushGold}" Background="#161B28"
                                         BorderThickness="0" Margin="0,0,0,4"
                                         VerticalAlignment="Top" />

                            <!-- Кнопка действия -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Height="32" CornerRadius="8"
                                    Command="{Binding InstallOrToggleCommand}"
                                    Classes.installed="{Binding IsInstalled}"
                                    Classes.notInstalled="{Binding !IsInstalled}">
                                <Button.Styles>
                                    <!-- Стиль: Установлен (Спектральный зелёный) -->
                                    <Style Selector="Button.installed">
                                        <Setter Property="Background" Value="#184FE0A8" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushSpectralGreenBorder}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushSpectralGreen}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="FontSize" Value="11.5" />
                                    </Style>
                                    <Style Selector="Button.installed:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#254FE0A8" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushSpectralGreen}" />
                                    </Style>

                                    <!-- Стиль: Не установлен (Тёмная с золотым hover) -->
                                    <Style Selector="Button.notInstalled">
                                        <Setter Property="Background" Value="#121620" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLine}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushBoneText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="11.5" />
                                    </Style>
                                    <Style Selector="Button.notInstalled:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource BrushGoldGradient}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#1A1204" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" Foreground="{StaticResource BrushSpectralGreen}" IsVisible="{Binding IsInstalled}" />
                                    <TextBlock Text="{Binding ActionButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Button>
</UserControl>