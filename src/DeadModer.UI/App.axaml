    <Application.Styles>
        <FluentTheme />
        
        <!-- Глобальное идеальное выравнивание текста и контента всех кнопок по центру -->
        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Стили для кнопок навигации -->
        <Style Selector="Button.sidebarNav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A94A6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sidebarNav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#151A26" />
            <Setter Property="BorderBrush" Value="#222B3D" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>
        <Style Selector="Button.sidebarNav.active">
            <Setter Property="Background" Value="#182030" />
            <Setter Property="BorderBrush" Value="#2A3750" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.sidebarNav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#182030" />
            <Setter Property="BorderBrush" Value="#2A3750" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Стили для карточек и кнопок действий -->
        <Style Selector="Button.pillCategory">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E2536" />
            <Setter Property="Background" Value="#131722" />
            <Setter Property="Foreground" Value="#8A94A6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pillCategory:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2030" />
            <Setter Property="BorderBrush" Value="#2A3750" />
            <Setter Property="Foreground" Value="#CBD4E1" />
        </Style>
        <Style Selector="Button.pillCategory.active">
            <Setter Property="Background" Value="#1F2A40" />
            <Setter Property="BorderBrush" Value="#384C72" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Стили для кнопок фильтров и сортировки -->
        <Style Selector="Button.pillFilter">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E2536" />
            <Setter Property="Background" Value="#131722" />
            <Setter Property="Foreground" Value="#8A94A6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pillFilter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2030" />
            <Setter Property="BorderBrush" Value="#2A3750" />
            <Setter Property="Foreground" Value="#CBD4E1" />
        </Style>
        <Style Selector="Button.pillFilter.active">
            <Setter Property="Background" Value="#1F2A40" />
            <Setter Property="BorderBrush" Value="#384C72" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.pillFilter.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F2A40" />
            <Setter Property="BorderBrush" Value="#384C72" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Быстрые карточки правого сайдбара -->
        <Style Selector="Button.quickActionCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.quickActionCard /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.quickActionCard:pointerover Border">
            <Setter Property="Background" Value="#181E2C" />
            <Setter Property="BorderBrush" Value="#2B364C" />
        </Style>

        <!-- Стили для пагинации героев -->
        <Style Selector="Button.pillPagination">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E273A" />
            <Setter Property="Background" Value="#121624" />
            <Setter Property="Foreground" Value="#8A94A6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pillPagination:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2030" />
            <Setter Property="BorderBrush" Value="#2A3750" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.pillPagination.active">
            <Setter Property="Background" Value="#1F2A40" />
            <Setter Property="BorderBrush" Value="#384C72" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Стили для вкладок модальной страницы мода -->
        <Style Selector="Button.pillDetailTab">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1C2436" />
            <Setter Property="Background" Value="#101420" />
            <Setter Property="Foreground" Value="#858EA0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pillDetailTab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#161C2C" />
            <Setter Property="BorderBrush" Value="#25324A" />
            <Setter Property="Foreground" Value="#CBD5E1" />
        </Style>
        <Style Selector="Button.pillDetailTab.active">
            <Setter Property="Background" Value="#1E283C" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Styles>
</Application>